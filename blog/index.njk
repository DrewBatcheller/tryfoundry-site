---
layout: base.njk
title: Blog
pageTitle: Blog
description: Notes on building agent teams for Claude Code.
permalink: /blog/index.html
---

{% block extraStyles %}
  .blog-index { max-width: 760px; margin: 0 auto; padding: 0 24px; }
  .blog-index header { margin-bottom: 40px; padding-bottom: 24px; border-bottom: 1px solid rgba(255,255,255,0.06); }
  .blog-index h1 {
    font-size: 36px;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }
  .blog-index .blog-sub { color: #9ca3af; font-size: 16px; }
  .blog-index .post-list { list-style: none; padding: 0; margin: 0; }
  .blog-index .post-item { padding: 24px 0; border-bottom: 1px solid rgba(255,255,255,0.04); }
  .blog-index .post-item:last-child { border-bottom: none; }
  .blog-index .post-item time {
    font-size: 12px;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    display: block;
    margin-bottom: 8px;
  }
  .blog-index .post-item h2 {
    font-size: 22px;
    font-weight: 600;
    color: #fff;
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }
  .blog-index .post-item h2 a { color: #fff; }
  .blog-index .post-item h2 a:hover { color: #c4b5fd; text-decoration: none; }
  .blog-index .post-item .summary { color: #9ca3af; font-size: 15px; line-height: 1.55; }
  .blog-index .empty {
    color: #6b7280;
    font-style: italic;
    padding: 40px 0;
    text-align: center;
  }
  .rss-link { font-size: 12px; color: #9ca3af; }
{% endblock %}

<div class="blog-index">
  <header>
    <h1>Blog</h1>
    <p class="blog-sub">Notes on building agent teams for Claude Code. <a class="rss-link" href="/blog/feed.xml">RSS</a></p>
  </header>

  {% if collections.posts and collections.posts.length > 0 %}
  <ul class="post-list">
    {% for post in collections.posts %}
      <li class="post-item">
        <time datetime="{{ post.date | isoDate }}">{{ post.date | postDate }}</time>
        <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        {% if post.data.summary %}<p class="summary">{{ post.data.summary }}</p>{% endif %}
      </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="empty">No posts yet.</p>
  {% endif %}
</div>
