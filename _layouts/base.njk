<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="{{ description or 'Foundry blog: notes on building agent teams for Claude Code.' }}" />
  <meta property="og:title" content="{{ pageTitle or title }}" />
  <meta property="og:description" content="{{ description or 'Foundry blog: notes on building agent teams for Claude Code.' }}" />
  <meta property="og:type" content="{{ ogType or 'website' }}" />
  <meta property="og:url" content="https://tryfoundry.dev{{ page.url }}" />
  <title>{{ pageTitle or title }} · Foundry</title>
  <link rel="alternate" type="application/rss+xml" title="Foundry blog" href="/blog/feed.xml" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%94%A8%3C/text%3E%3C/svg%3E" />
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: #0a0a0f;
      color: #e5e7eb;
      line-height: 1.6;
      min-height: 100vh;
      background-image:
        radial-gradient(ellipse 80% 60% at 50% -20%, rgba(139, 92, 246, 0.15), transparent),
        radial-gradient(ellipse 60% 40% at 80% 40%, rgba(59, 130, 246, 0.08), transparent);
      background-attachment: fixed;
    }
    a { color: #a78bfa; text-decoration: none; }
    a:hover { color: #c4b5fd; text-decoration: underline; }
    code {
      font-family: "SF Mono", Menlo, Consolas, monospace;
      font-size: 0.9em;
      background: rgba(255,255,255,0.06);
      padding: 1px 5px;
      border-radius: 4px;
    }
    pre {
      background: rgba(0,0,0,0.4);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 8px;
      padding: 16px 18px;
      overflow-x: auto;
      margin: 20px 0;
      font-family: "SF Mono", Menlo, Consolas, monospace;
      font-size: 13.5px;
      line-height: 1.5;
    }
    pre code {
      background: transparent;
      padding: 0;
      font-size: inherit;
    }
    .container { max-width: 760px; margin: 0 auto; padding: 0 24px; }

    nav.site-nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 20px 0;
      max-width: 1080px;
      margin: 0 auto;
      padding-left: 24px;
      padding-right: 24px;
    }
    .brand {
      font-size: 17px;
      font-weight: 600;
      letter-spacing: -0.01em;
      color: #fff;
    }
    .brand .dot { color: #a78bfa; }
    .nav-links { display: flex; gap: 4px; align-items: center; }
    .nav-links a {
      font-size: 13px;
      color: #9ca3af;
      padding: 8px 14px;
      border-radius: 8px;
      text-decoration: none;
    }
    .nav-links a:hover { color: #fff; background: rgba(255,255,255,0.04); }

    main.blog-main { padding: 32px 0 80px; }

    footer.site-footer {
      max-width: 1080px;
      margin: 60px auto 0;
      padding: 32px 24px;
      border-top: 1px solid rgba(255,255,255,0.06);
      font-size: 12px;
      color: #6b7280;
      text-align: center;
    }
    footer.site-footer .footer-links {
      display: flex;
      gap: 16px;
      justify-content: center;
      margin-bottom: 12px;
    }
    footer.site-footer a { color: #9ca3af; text-decoration: none; }
    footer.site-footer a:hover { color: #fff; }

    {% block extraStyles %}{% endblock %}
  </style>
</head>
<body>
  <nav class="site-nav">
    <a href="/" class="brand">Foundry<span class="dot">.</span></a>
    <div class="nav-links">
      <a href="/blog/">Blog</a>
      <a href="/build-notes.html">Releases</a>
      <a href="/faq.html">FAQ</a>
      <a href="/">Home</a>
    </div>
  </nav>

  <main class="blog-main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="footer-links">
      <a href="/privacy.html">Privacy</a>
      <a href="https://bsky.app/profile/drew.tryfoundry.dev" target="_blank" rel="noopener">Bluesky</a>
      <a href="https://discord.gg/kGBpQcTc68" target="_blank" rel="noopener">Discord</a>
      <a href="https://ko-fi.com/tryfoundry" target="_blank" rel="noopener">Ko-fi</a>
      <a href="mailto:hello@tryfoundry.dev">Contact</a>
    </div>
    <div>© Foundry · Built for Claude Code</div>
  </footer>
</body>
</html>
