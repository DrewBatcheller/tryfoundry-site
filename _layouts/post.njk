---
layout: base.njk
ogType: article
---

{% block extraStyles %}
  article.post { max-width: 720px; margin: 0 auto; padding: 0 24px; }
  article.post header { margin-bottom: 32px; padding-bottom: 24px; border-bottom: 1px solid rgba(255,255,255,0.06); }
  article.post .post-date { font-size: 12px; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 14px; display: block; }
  article.post h1 {
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: #fff;
    margin-bottom: 12px;
  }
  article.post .post-summary { font-size: 17px; color: #9ca3af; line-height: 1.55; }
  article.post .post-body { font-size: 16px; color: #d1d5db; }
  article.post .post-body h2 {
    font-size: 24px;
    font-weight: 600;
    color: #fff;
    margin: 36px 0 14px;
    letter-spacing: -0.01em;
  }
  article.post .post-body h3 {
    font-size: 19px;
    font-weight: 600;
    color: #f3f4f6;
    margin: 28px 0 10px;
  }
  article.post .post-body p { margin-bottom: 16px; }
  article.post .post-body ul, article.post .post-body ol { margin: 0 0 16px 24px; }
  article.post .post-body li { margin-bottom: 6px; }
  article.post .post-body strong { color: #fff; font-weight: 600; }
  article.post .post-body em { color: #e5e7eb; font-style: italic; }
  article.post .post-body blockquote {
    border-left: 3px solid rgba(139,92,246,0.4);
    padding: 4px 16px;
    margin: 20px 0;
    color: #9ca3af;
    font-style: italic;
  }
  article.post footer.post-footer {
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid rgba(255,255,255,0.06);
    font-size: 14px;
    color: #9ca3af;
  }
  article.post footer.post-footer a { color: #a78bfa; }
{% endblock %}

<article class="post">
  <header>
    <time class="post-date" datetime="{{ date | isoDate }}">{{ date | postDate }}</time>
    <h1>{{ title }}</h1>
    {% if summary %}<p class="post-summary">{{ summary }}</p>{% endif %}
  </header>
  <div class="post-body">
    {{ content | safe }}
  </div>
  <footer class="post-footer">
    <p><a href="/blog/">← All posts</a> · <a href="/">Foundry home</a></p>
  </footer>
</article>
